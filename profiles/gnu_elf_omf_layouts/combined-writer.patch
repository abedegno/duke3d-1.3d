+// Task598: finite opt-in source metadata. No runtime bytes/symbols are supplied.
+void CCOF2OMF::ReadSourceGroups() {
+   FlatGroupIndex = 1;
+   if (!cmd.OMFGroupPlan) return;
+   auto fail = [](const char * message) {
+      fprintf(stderr, "OMF group plan: %s\n", message); exit(1);
+   };
+   FILE * file = fopen(cmd.OMFGroupPlan, "rb");
+   if (!file) fail("cannot open source metadata");
+   char line[4096];
+   auto readLine = [&]() -> std::string {
+      if (!fgets(line, sizeof(line), file) || !strchr(line, '\n')) fail("missing/truncated/NUL metadata line");
+      return std::string(line);
+   };
+   if (readLine() != "OMF_GROUPS_V1\n") fail("bad header");
+   std::istringstream members(readLine());
+   std::string token;
+   if (!(members >> token) || token != "group" || !(members >> token) || token != "DGROUP") fail("one DGROUP definition required");
+   while (members >> token) {
+      if (token.empty() || token.size()>255 || SourceGroupCount==127) fail("invalid/excessive member name");
+      for (size_t c=0;c<token.size();c++) {
+         unsigned char ch=token[c];
+         if (!((ch>='A'&&ch<='Z')||(ch>='a'&&ch<='z')||(ch>='0'&&ch<='9')||ch=='_'||ch=='.'||ch=='$')) fail("invalid member spelling");
+      }
+      uint32_t found=0;
+      for (int sec=1;sec<SectionBufferNum;sec++) {
+         if (!SectionBuffer[sec].NewNameI) continue;
+         const char * name=(char*)NameBuffer.Buf()+SectionBuffer[sec].NewName;
+         if (token==name) {
+            if (found) fail("ambiguous source section");
+            if (SectionBuffer[sec].Class!=OMF_LNAME_DATA && SectionBuffer[sec].Class!=OMF_LNAME_BSS && SectionBuffer[sec].Class!=OMF_LNAME_CONST) fail("DGROUP member must be a genuine DATA/CONST/BSS section");
+            found=SectionBuffer[sec].NewNumber;
+         }
+      }
+      if (!found) fail("undefined source section");
+      for (uint32_t i=0;i<SourceGroupCount;i++) if (SourceGroupSegments[i]==found) fail("duplicate member");
+      SourceGroupSegments[SourceGroupCount++]=found;
+   }
+   if (!SourceGroupCount) fail("empty DGROUP");
+   if (readLine()!="flat FLAT\n" || readLine()!="end\n" || fgetc(file)!=EOF || ferror(file)) fail("duplicate/unknown group or trailing input");
+   fclose(file);
+   FlatGroupIndex=2; // DGROUP is emitted before FLAT, never confuse LNAMES with GRPDEF index.
+   SourceGroupNameIndex=OMF_LNAME_LAST+NumSegments+1;
+}
+uint32_t CCOF2OMF::SourceGroupForSegment(uint32_t segment) {
+   if (!segment) return 0;
+   for (uint32_t i=0;i<SourceGroupCount;i++) if (SourceGroupSegments[i]==segment) return 1;
+   return FlatGroupIndex;
+}
