+// Task600: omit only three unused automatic GNU defaults under explicit source policy.
+// This never removes an allocated byte, actual definition, relocation or alignment.
+void CCOF2OMF::ValidateUnusedGNUDefaults() {
+   if (!cmd.OmitUnusedGNUDefaults) return;
+   auto fail = [](const char * message) {
+      fprintf(stderr, "OMF unused GNU defaults: %s\n", message); exit(1);
+   };
+   const char * names[3]={".text",".data",".bss"};
+   const uint32_t flags[3]={0x60100020,0xC0100040,0xC0100080};
+   for (uint32_t sec=0; sec<(uint32_t)NSections; sec++) {
+      SCOFF_SectionHeader & h=SectionHeaders[sec];
+      const char * name=GetSectionName(h.Name);
+      for (uint32_t i=0;i<3;i++) if (!strcmp(name,names[i])) {
+         if (OmittedGNUDefaultSections[i]) fail("duplicate automatic section");
+         if (h.Flags!=flags[i] || h.VirtualSize || h.VirtualAddress || h.SizeOfRawData || h.PRawData || h.PRelocations || h.PLineNumbers || h.NRelocations || h.NLineNumbers) fail("noncanonical bytes/flags/alignment/relocation/line metadata");
+         OmittedGNUDefaultSections[i]=sec+1;
+      }
+   }
+   for (uint32_t i=0;i<3;i++) if (!OmittedGNUDefaultSections[i]) fail("exact three automatic defaults required");
+   for (uint32_t sym=0;sym<(uint32_t)NumberOfSymbols;) {
+      SCOFF_SymTableEntry & s=*(SCOFF_SymTableEntry*)((int8_t*)SymbolTable+sym*SIZE_SCOFF_SymTableEntry);
+      if (sym+s.s.NumAuxSymbols>=(uint32_t)NumberOfSymbols) fail("invalid symbol/auxiliary bounds");
+      const char * name=GetSymbolName(s.s.Name);
+      for (uint32_t i=0;i<3;i++) {
+         if (s.s.SectionNumber==(int16_t)OmittedGNUDefaultSections[i] || !strcmp(name,names[i])) fail("actual named/section/public/private/import identity in omitted default");
+      }
+      sym+=s.s.NumAuxSymbols+1;
+   }
+   // Any incoming relocation is necessarily to a real symbol above; check source
+   // fields independently as well. Group names are resolved later against only
+   // the retained real sections, so a requested omitted member fails undefined.
+}
